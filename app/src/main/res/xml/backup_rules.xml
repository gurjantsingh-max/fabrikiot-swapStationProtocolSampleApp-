<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and lower.
   The encrypted auth session is excluded: its Keystore key can't be restored on another device,
   and tokens must never leave the device via backups.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/auth_session.preferences_pb" />
</full-backup-content>
