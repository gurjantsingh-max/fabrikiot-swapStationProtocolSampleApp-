<?xml version="1.0" encoding="utf-8"?>
<!-- Backup / device-transfer rules for Android 12+. The encrypted auth session is never transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
